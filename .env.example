# Copy this file to .env.local and fill in real values.
# .env.local is git-ignored — never commit real keys.

# microCMS ---------------------------------------------------------------
# Service domain only, e.g. "irodori" for https://irodori.microcms.io
# Exposed to the browser (NEXT_PUBLIC_) because it is not sensitive on its own.
NEXT_PUBLIC_MICROCMS_SERVICE_DOMAIN=

# microCMS API key. Server-only — no NEXT_PUBLIC_ prefix. Never expose this
# to client components; only read it in Server Components / Route Handlers
# (see src/lib/microcms.ts).
MICROCMS_API_KEY=

# Site ---------------------------------------------------------------------
# Canonical production URL, used for metadata/sitemap/robots/OG tags.
NEXT_PUBLIC_SITE_URL=https://example.com

# Contact form (Resend) ----------------------------------------------------
# Server-only. Get a key at https://resend.com/api-keys after creating a
# free account. Without this the form still renders but shows a friendly
# "can't send right now" error (see src/app/actions/contact.ts).
RESEND_API_KEY=

# Where contact-form submissions are delivered.
CONTACT_TO_EMAIL=

# Optional. "From" address shown on the email Resend sends. Without your own
# verified sending domain, Resend can only send from its shared
# onboarding@resend.dev address — fine for CONTACT_TO_EMAIL being your own
# inbox. Once irodoriweb.com is verified with Resend, set this to something
# like "irodori <hello@irodoriweb.com>".
CONTACT_FROM_EMAIL=
